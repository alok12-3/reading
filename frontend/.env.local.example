# Example environment variables for Next.js frontend

# Base URL for the backend API
# This is exposed to the browser because it's prefixed with NEXT_PUBLIC_
# For local development, if your backend runs on port 8000:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Other frontend-specific environment variables can go here
# For example, if you use a third-party service with a public client key:
# NEXT_PUBLIC_ANALYTICS_KEY=your_public_analytics_key_here
