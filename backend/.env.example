# Example Environment Variables for Passage Analyzer Backend

# Database Configuration
# Replace with your actual database connection string.
# Format: postgresql+psycopg2://username:password@host:port/database_name
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/passagedb

# Google Generative AI API Key
# Replace with your actual Google API Key for LLM features.
GOOGLE_API_KEY="your_google_api_key_here"

# Application Settings (Optional - FastAPI default port is 8000)
# HOST=0.0.0.0
# PORT=8000

# Uvicorn Settings (Optional)
# WORKERS=1 # Number of worker processes for Uvicorn
# LOG_LEVEL=info # Logging level for Uvicorn (e.g., debug, info, warning, error, critical)
